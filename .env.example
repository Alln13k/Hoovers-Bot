# ==========================================
#  HOOVERS - Bot Discord (Node)
#  !! NE JAMAIS COMMIT CE FICHIER
#  !! Ne jamais coller ces cles dans un salon Discord
# ==========================================

# Regenere sur Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=ton_token_ici

CLIENT_ID=ton_application_id
GUILD_ID=ton_serveur_id
OWNER_IDS=ton_user_id

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://tonprojet.supabase.co

# On utilise la service_role : le RLS de supabase_schema.sql bloque l'anon.
# C'est ce qui permet au bot d'ecrire. Ne l'expose jamais.
SUPABASE_KEY=ta_cle_service_role

# ---- Salons du serveur (laisser vide au depart) ----
LOG_SANCTIONS_CHANNEL_ID=
LOG_AUDIT_CHANNEL_ID=
LOG_TICKETS_CHANNEL_ID=

# ---- Categorie des tickets ----
TICKETS_CATEGORY_ID=
