# ==========================================
#  Bot communautaire - variables d'environnement
#  !! NE JAMAIS COMMIT CE FICHIER
# ==========================================

# --- Discord ---
# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=ton_token_ici
CLIENT_ID=ton_application_id

# Ton user ID, pour les commandes de maintenance
OWNER_IDS=ton_user_id

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://tonprojet.supabase.co
# La service_role : elle contourne le RLS. Ne jamais l'exposer.
SUPABASE_KEY=ta_cle_service_role

# --- Site web (dashboard) ---
# URL publique du site, sans slash final
SITE_URL=https://monbot.fr
PORT=3000

# Discord Developer Portal > OAuth2 > Secret
# Redirect URI a enregistrer : {SITE_URL}/auth/callback
CLIENT_SECRET=ton_client_secret

# Long chaine aleatoire, pour signer les cookies
# genere avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=une_longue_chaine_aleatoire
